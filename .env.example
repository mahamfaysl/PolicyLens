# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=

# Optional tuning (defaults shown)
# PL_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest
# PL_SINGLE_PASS_CHARS=150000   # documents up to this size are analysed in one call
# PL_CHUNK_CHARS=60000          # section size for larger documents
# PL_MAX_WORKERS=8              # parallel section calls
# PL_TIMEOUT_S=90
# PL_RETRIES=2
# PL_MAX_PAGES=2000
